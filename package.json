{
  "name": "dsh-frontend-feedback",
  "version": "0.3.0",
  "description": "DeepSeek Harness plugin for building, previewing, annotating, and refining frontend pages",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "skills/frontend-design/SKILL.md",
    "skills/frontend-page-builder/SKILL.md",
    "skills/presentation-builder/SKILL.md",
    "README.md",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --import tsx --test tests/**/*.test.ts",
    "check": "npm run typecheck && npm test && npm pack --dry-run --cache .npm-cache"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.5 <0.2.0",
    "@deepseek-ai/dsh-skill": ">=0.1.0-rc.5 <0.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noabt187/dsh-PageCraft.git"
  },
  "homepage": "https://github.com/noabt187/dsh-PageCraft#readme",
  "bugs": {
    "url": "https://github.com/noabt187/dsh-PageCraft/issues"
  },
  "license": "UNLICENSED",
  "private": true
}
